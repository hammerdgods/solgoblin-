# SolGoblin configuration. Copy to .env.local and edit.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are sent to the browser.

# --- Network (public) -------------------------------------------------------
# "devnet" (default, safe for testing), "mainnet-beta", or "localnet" (solana-test-validator
# at http://127.0.0.1:8899; the RPC must NOT be a public cluster).
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# RPC used by the browser wallet adapter. Defaults to the public endpoint for the network.
# Public endpoints are rate limited. If your provider URL contains an API key, use a key
# restricted to your domain — anything NEXT_PUBLIC_ is visible to users.
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Server-side RPC (secret allowed) ---------------------------------------
# Used for all server reads, simulation and submission. Defaults to NEXT_PUBLIC_SOLANA_RPC_URL.
SOLANA_RPC_URL=

# --- AI (optional, server-only) ---------------------------------------------
# Without a key, recommendations use the deterministic engine only.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Persistence (optional, server-only) ------------------------------------
# If unset, data is stored in a local JSON file under DATA_DIR (default .data/).
# The service-role key is required because wallets are not Supabase users; tables use RLS
# with no anon policies, so only the server can access them. Never expose this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATA_DIR=.data

# --- Transaction safety ------------------------------------------------------
# Emergency stop: when true, no transaction can be prepared or submitted.
TRANSACTIONS_KILL_SWITCH=false
# Mainnet execution is OFF by default. Enable only after the /app/settings checks pass.
ENABLE_MAINNET_TRANSACTIONS=false
# Comma-separated vote account addresses users may stake to. Required for mainnet staking.
# On devnet, if empty, a validator is auto-selected (highest stake, commission <= 10%).
STAKE_VALIDATOR_VOTE_ACCOUNTS=
# SOL always left in the wallet for future fees.
MIN_SOL_RESERVE=0.05
# Per-transaction caps.
MAX_DEPOSIT_SOL=10
MAX_DEPOSIT_USDC=1000
# Maximum priority fee (lamports) a transaction may request.
MAX_PRIORITY_FEE_LAMPORTS=2000000

# --- Monitoring ---------------------------------------------------------------
DATA_STALE_AFTER_SECONDS=900
APY_CHANGE_ALERT_BPS=100
LENDING_UTILIZATION_WARNING=0.95
# Used by `npm run monitor` (local loop).
MONITOR_INTERVAL_SECONDS=300
# Optional comma-separated wallets to snapshot and review on each monitoring run.
MONITOR_WALLETS=
# Required for scheduled GET /api/monitor/run (sent as "Authorization: Bearer <secret>").
CRON_SECRET=
